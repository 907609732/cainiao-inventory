{
  "name": "wucheng-ecommerce-erp-v2",
  "version": "0.9.4",
  "description": "五成电子商务工作台统一源码与云仓组件",
  "author": "五成电子商务集团",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "desktop": "electron .",
    "warehouse:dev": "electron .",
    "warehouse:build": "node desktop/prepare-build.mjs --channel=release && electron-builder --config build/electron-builder.config.cjs --win nsis",
    "build": "node desktop/prepare-build.mjs --channel=release && electron-builder --config build/electron-builder.config.cjs --win nsis",
    "build:installer": "node desktop/prepare-build.mjs --channel=release && electron-builder --config build/electron-builder.config.cjs --win nsis",
    "test": "node --test tests/*.test.*",
    "test:core": "node --test tests/cainiao-export-controls.test.js tests/dingtalk-auth.test.js tests/dingtalk-app-robot.test.js tests/dingtalk-inventory-reminder.test.js tests/inventory-validation.test.js",
    "test:warehouse-sales": "node --test tests/warehouse-monthly-sales.test.js tests/monthly-sales-dashboard.test.js",
    "test:desktop": "node --test tests/desktop-*.test.*",
    "test:ui": "node tests/warehouse-ui.mjs",
    "ai:status": "electron . --cli status",
    "ai:doctor": "electron . --cli doctor",
    "ai:send-latest-valid": "electron . --cli send-latest-valid --confirm-send",
    "ai:mcp": "electron . --mcp-stdio",
    "setup": "playwright install chromium",
    "test:login": "node core/playwright-login.js",
    "sync:inventory:local": "node core/sync-cainiao-inventory.js",
    "sync:sales:monthly": "node core/sync-cainiao-monthly-sales.js",
    "sync:sales:backfill": "node core/backfill-cainiao-monthly-sales.js --from 2025-08 --to 2026-07",
    "docs:features": "node scripts/export-feature-help.mjs",
    "test:feature-help": "node --test tests/feature-help-content.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/reply-from": "12.8.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "axios": "^1.20.0",
    "dingtalk-stream": "^2.1.5",
    "dotenv": "^16.4.7",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "fastify": "^5.12.5",
    "gridjs": "^6.2.0",
    "playwright": "^1.49.1",
    "semver": "7.7.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/inspector": "^2.8.0",
    "@playwright/test": "^1.61.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "turbo": "2.11.10",
    "yazl": "3.3.1"
  },
  "packageManager": "npm@11.16.0"
}
