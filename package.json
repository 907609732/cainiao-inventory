{
  "name": "cainiao-inventory-windows-workspace",
  "version": "0.9.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix windows/workbench run dev",
    "start": "npm --prefix windows/workbench start",
    "build": "npm --prefix windows/workbench run warehouse:build -- --publish never",
    "test": "npm --prefix windows/workbench test",
    "test:ui": "npm --prefix windows/workbench run test:ui",
    "docs:features": "npm --prefix windows/workbench run docs:features",
    "build:extension": "node scripts/build-windows.mjs",
    "docs:screenshots": "npm --prefix windows/workbench run docs:screenshots",
    "web": "npm --prefix windows/workbench run web",
    "test:web": "npm --prefix windows/workbench run test:ui:web"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
