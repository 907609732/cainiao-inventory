#!/bin/bash
set -euo pipefail
umask 077
for port in 18761 18762; do
  if timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" >/dev/null 2>&1; then
    printf 'Cloud warehouse port %s is already in use; no existing service was stopped.\n' "$port" > "${TRIM_TEMP_LOGFILE:?}"
    exit 1
  fi
done
mkdir -p "${TRIM_PKGVAR:?}/data"
chmod 700 "$TRIM_PKGVAR/data"
origin="${wizard_public_origin:?Public origin is required}"
if [[ ! "$origin" =~ ^https?://([A-Za-z0-9.-]+|\[[A-Fa-f0-9:]+\])(:[0-9]{1,5})?$ ]]; then
  printf '%s\n' 'Invalid public origin: scheme and host only, no path or credentials.' > "${TRIM_TEMP_LOGFILE:?}"
  exit 1
fi
printf '%s' "$origin" > "$TRIM_PKGVAR/data/public-origin"
password="${wizard_admin_password:?Administrator password is required}"
if (( ${#password} < 16 || ${#password} > 256 )) || [[ "$password" == *$'\n'* ]]; then
  printf '%s\n' 'Administrator password must be 16 to 256 characters, without newlines.' > "${TRIM_TEMP_LOGFILE:?}"
  exit 1
fi
if [ ! -e "$TRIM_PKGVAR/data/admin-password" ] && [ ! -e "$TRIM_PKGVAR/data/nas-auth.json" ]; then
  printf '%s' "$password" > "$TRIM_PKGVAR/data/admin-password"
  chmod 600 "$TRIM_PKGVAR/data/admin-password"
fi
unset password wizard_admin_password
# Image is imported separately by the authorized NAS administrator. The package
# account does not receive docker-group membership or host root permissions.
