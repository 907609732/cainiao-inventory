{
  "name": "cainiao-inventory-automation-core",
  "version": "1.0.0",
  "description": "Reusable Cainiao inventory export, validation, reporting, DingTalk, and scheduling module",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "cainiao-inventory": "./dist/cli.cjs"
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts"
  },
  "devDependencies": {
    "exceljs": "4.4.0",
    "playwright": "1.61.1",
    "tsup": "8.5.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
